# Uploaded files are data, never code: block script execution in this folder.

# 1. Refuse any request for script-like files (also covers double extensions like file.php.pdf)
<FilesMatch "(?i)\.(php\d?|phtml|phar|pht|phps|cgi|pl|py|sh|exe|asp|aspx|jsp|htaccess)(\.|$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Deny,Allow
        Deny from all
    </IfModule>
</FilesMatch>

# 2. Turn the PHP engine off here (only where mod_php allows it, so this never causes a 500)
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>

# 3. No directory listings
Options -Indexes
